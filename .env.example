# ---- Auth: none of these needed by default ----
# docker-compose.yml mounts your host ~/.claude read-only; agent-loop.sh copies it into each
# role's container at startup, reusing your logged-in Claude Code plan session. Only set one of
# these if you'd rather not share that: a plan session token, or pay-as-you-go API billing.
# CLAUDE_CODE_OAUTH_TOKEN=        # from `claude setup-token`
# ANTHROPIC_API_KEY=

# ---- Per-role models (empty = Claude Code default) ----
MODEL_PO=
MODEL_ARCHITECT=
MODEL_ENGINEER=
MODEL_QA=
MODEL_REVIEWER=

# ---- Loop behaviour ----
MAX_TURNS=60                  # tool-use turns per session
ITERATION_TIMEOUT=45m         # hard wall-clock cap per session
IDLE_SLEEP=60                 # seconds between polls when the queue is empty
MAX_ATTEMPTS_PER_ISSUE=2      # then the issue is labelled needs-human
MAX_CONSECUTIVE_FAILURES=3    # circuit breaker: agent stops and alerts
WIP_LIMIT=2                   # PO won't start a new story while this many are in flight
# QUOTA_RETRY_INTERVAL=900      # fallback poll interval (seconds) when a Claude Code plan usage
                               # limit is hit and no reset time could be parsed from the CLI's
                               # message; never counts as a failed attempt (see README)
# empty = no cap (summed across all agents). Keep the value blank with no trailing comment on
# this line - docker compose's env_file parser takes a comment after an empty value literally.
DAILY_BUDGET_USD=
HUMAN_APPROVE_STORIES=1       # 1 = new stories wait for `approve.sh <architect-issue>` before design starts

# ---- Optional push notifications (e.g. https://ntfy.sh/your-secret-topic) ----
NOTIFY_URL=

# ---- Dolt (beads database) ----
# Published on 127.0.0.1 only, so `bd` works directly from PROJECT_DIR in your own host shell,
# not just from inside a container pane. Change only if something else on your host already
# uses 3306.
# DOLT_HOST_PORT=3306
