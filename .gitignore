.env
data/
.agent-factory/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
.beads/issues.jsonl

# Dotfile to add to the factory-agent image
dotfiles/*

# Operator-supplied extra CA certs for the agent image (see docs/ARCHITECTURE.md)
extra-ca/*
!extra-ca/.gitkeep
